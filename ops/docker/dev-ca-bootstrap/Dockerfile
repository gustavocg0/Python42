# syntax=docker/dockerfile:1.7
# One-shot dev CA bootstrap (design §7: "dev CA generated by a bootstrap
# script — non-production per SEC-9"). Runs ONCE per compose project as root
# (it must chown key material to the consuming services' UIDs), writes into
# the named volume `dev-ca`, and exits. Idempotent: re-runs are no-ops.
# Build context: repository root.

FROM alpine:3.22@sha256:7c8cb692ae09657cbc4a3f3cbd0e8d5a2690ba38386aaaf252dbb060bf5eb2e6

RUN apk add --no-cache openssl

COPY --chmod=0755 ops/docker/dev-ca-bootstrap/bootstrap.sh /usr/local/bin/dev-ca-bootstrap

ENTRYPOINT ["/usr/local/bin/dev-ca-bootstrap"]
