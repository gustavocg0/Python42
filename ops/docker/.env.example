# ---------------------------------------------------------------------------
# POC compose environment TEMPLATE (SEC-49).
#
# NEVER put real secrets in this file — it is committed. scripts/poc-up.sh
# copies it to the repo-root .env (git-ignored) and replaces every
# __GENERATE__ with a fresh random hex value. All values below are dev-only.
# ---------------------------------------------------------------------------

# --- store credentials -------------------------------------------------------
# Owner/migration user (db/README.md: owns all objects; NEVER a runtime role).
POSTGRES_OWNER_PASSWORD=__GENERATE__
# Runtime LOGIN roles created by the migrate one-shot (db/README.md role model).
SVC_CONTROLPLANE_DB_PASSWORD=__GENERATE__
SVC_DATAPLANE_DB_PASSWORD=__GENERATE__
SVC_JOBS_DB_PASSWORD=__GENERATE__
REDIS_PASSWORD=__GENERATE__
# Elasticsearch `elastic` superuser (dev single node; basic auth, no TLS).
ES_PASSWORD=__GENERATE__

# --- internal service auth (design §5.1 / SEC-40) ----------------------------
# Gateway -> dataplane hop secret (X-Gateway-Auth, 256-bit).
GATEWAY_AUTH_SECRET=__GENERATE__
# HMAC service-token keys, one per direction:
#   controlplane -> dataplane  (CP_OUTBOUND_SERVICE_KEY == DP_INTERNAL_SERVICE_KEYS["controlplane"])
SVC_KEY_CONTROLPLANE=__GENERATE__
#   dataplane -> controlplane  (DP_ENTITLEMENTS_SIGNING_KEY == CP_SVC_KEY_DATAPLANE)
SVC_KEY_DATAPLANE=__GENERATE__

# --- signup abuse challenge stub (SEC-5) -------------------------------------
# The dev challenge verifier accepts exactly this value; scripts/poc-smoke.sh
# presents it if signup trips the IP-velocity threshold.
CP_CHALLENGE_STUB_TOKEN=__GENERATE__

# --- agent demo profile -------------------------------------------------------
# Filled by scripts/poc-smoke.sh (creates an enrollment token via the API).
# Used by the `agent-sim` service: docker compose --profile demo up -d agent-sim
SOC_ENROLL_TOKEN=

# --- host ports ---------------------------------------------------------------
WEB_HTTP_PORT=8080     # console  http://localhost:8080  (browser origin)
CP_HTTP_PORT=8081      # controlplane public API (via gateway)
DP_HTTP_PORT=8082      # dataplane public API + generic ingest (via gateway)
AGENT_MTLS_PORT=8443   # agent mTLS listener (via gateway)
MAILPIT_UI_PORT=8025   # mailpit web UI / API (dev email)

# Debug profile only (docker compose --profile debug up -d):
DEBUG_POSTGRES_PORT=5432
DEBUG_REDIS_PORT=6379
DEBUG_ES_PORT=9200
